# ==============================================================================
# Agentic Commerce Demo — Environment Configuration Template
# ==============================================================================

# Google AI Studio / Gemini API Key (Obbligatoria per i backend con LLM Gemini)
# Ottienila gratuitamente da: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Opzionale: Configurazione Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west8

# Opzionale: Identità Acquirente Predefinita (per simulazioni locali)
DEFAULT_BUYER_NAME=Alex Rossi
DEFAULT_BUYER_EMAIL=alex.traveler@example.com

# Opzionale: Operatori Punto Vendita Autorizzati (per BOPIS Dashboard)
OPERATOR_EMAILS=merchant@agentic-commerce.demo
OPERATOR_NAME=Store Manager

# Opzionale: Chiavi crittografiche per simulazione locale di firme (AP2 & RFC 9421)
AP2_SHARED_SECRET_KEY=mock_ap2_secret_key_demo
RFC9421_SECRET_KEY=mock_rfc9421_secret_key_demo
RFC9421_KEY_ID=key-agentic-shopper-01

# Nota su Firebase:
# I frontend Angular funzionano in modalità autonoma offline/locale con fallback REST
# verso il server FastAPI (http://localhost:10999).
# La sincronizzazione Firestore in tempo reale è del tutto opzionale.
